// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum ScannedByRole {
  shopkeeper
  consumer
}

enum Verdict {
  genuine
  suspicious
  unverified
}

enum ReportStatus {
  pending
  investigating
  resolved
  dismissed
}

enum SubscriptionTier {
  free
  starter
  professional
  enterprise
}

enum ProductStatus {
  active
  flagged
  recalled
}

enum ScrapeRunStatus {
  running
  success
  partial_failure
  failed
}

enum VoucherStatus {
  issued
  redeemed
  expired
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Brand {
  id                String           @id @default(cuid())
  name              String
  contact_email     String           @unique
  subscription_tier SubscriptionTier @default(free)
  created_at        DateTime         @default(now())

  reports Report[]
}

model Product {
  // dbgenerated (not cuid()): the scraper and scripts/import-reference-images.mjs
  // both insert via the REST API, which never sees Prisma's client-side cuid()
  // default — same reasoning as Scan.id. Declaring it here keeps `db push` from
  // dropping the DB default as undeclared drift.
  id                      String        @id @default(dbgenerated("gen_random_uuid()::text"))
  sku                     String        @unique
  brand_name              String
  product_name            String
  reference_batch_pattern String        // regex or prefix, e.g. "^XP-[0-9]{3}-KHI"
  reference_image_url     String?
  pack_size               String?       // e.g. "30g,210g,400g,800g,3.25kg" — raw scraped pack-size list
  avg_unit_price_pkr      Float         @default(0) // used for estimated_losses calculation
  status                  ProductStatus @default(active)
  // Provenance: "manual" | "national_foods_scrape" | "open_food_facts"
  source                  String        @default("manual")
  last_scraped_at         DateTime?
  // CLIP image embedding for RAG-style vector similarity search.
  // Written/read via raw SQL (prisma/sql/pgvector_setup.sql) — Prisma Client
  // cannot query or write Unsupported columns directly.
  embedding               Unsupported("vector(512)")?
  created_at              DateTime      @default(now())

  // ── Medicine catalog fields ──────────────────────────────────────────────
  // "fmcg" for every existing row (food/household); "medicine" for rows from
  // the pharma scrapers. Vector search filters on it so a food scan can never
  // match a medicine reference image, or the other way round.
  category                String        @default("fmcg")
  gtin                    String?       // GS1 GTIN when the source publishes one (most pharma sites don't)
  generic_name            String?
  strength                String?       // e.g. "500 mg", "250 mg/5 ml"
  dosage_form             String?       // e.g. "Tablet", "Syrup"
  manufacturer            String?
  drap_reg_no             String?       // DRAP registration number, as printed on the pack
  source_url              String?       // public page the row was scraped from
  fetched_at              DateTime?     @db.Timestamptz(3)

  scans Scan[]

  @@index([source])
  @@index([category])
  @@index([gtin])
  @@index([drap_reg_no])
}

model ScrapeRun {
  // dbgenerated (not cuid()): src/app/api/scraper/national-foods/route.ts
  // inserts via the REST API, which never sees Prisma's client-side cuid()
  // default — it needs an actual Postgres-level default. Declaring it here
  // (instead of only in prisma/sql/manual_schema_patch.sql) keeps `db push`
  // from dropping it as undeclared drift the next time the schema changes.
  id               String          @id @default(dbgenerated("gen_random_uuid()::text"))
  source           String          // e.g. "national_foods_scrape"
  status           ScrapeRunStatus @default(running)
  products_found   Int             @default(0)
  products_created Int             @default(0)
  products_updated Int             @default(0)
  products_failed  Int             @default(0)
  error_log        Json?
  started_at       DateTime        @default(now())
  finished_at      DateTime?

  @@index([source])
  @@index([status])
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password_hash String
  score_points  Int      @default(0)
  created_at    DateTime @default(now())

  scans    Scan[]
  vouchers Voucher[]
}

model Admin {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
}

model Scan {
  // dbgenerated (not cuid()): src/app/api/verify/route.ts inserts via the
  // REST API, bypassing Prisma's client-side cuid() default entirely — it
  // needs an actual Postgres-level default or every real scan insert fails
  // with a NOT NULL violation on "id". Declaring it here (instead of only in
  // prisma/sql/manual_schema_patch.sql) keeps `db push` from dropping it as
  // undeclared drift the next time the schema changes.
  id               String        @id @default(dbgenerated("gen_random_uuid()::text"))
  product_id       String?       // nullable — no match found = unverified
  product_name     String?       // Cache product name for fallback lookups (UPCItemDB/OpenFoodFacts)
  brand_name       String?       // Cache brand name for fallback lookups (UPCItemDB/OpenFoodFacts)
  category         String?       // Cache product category from local catalog / UPCItemDB / OpenFoodFacts / BarcodeLookup
  barcode          String?       // Scanned/detected barcode (UI shows this under "Barcode" — no real factory/plant-code data exists anywhere in this app)
  scanned_by_role  ScannedByRole @default(consumer)
  customer_id      String?       // nullable — set when a logged-in consumer performed the scan
  image_url        String
  extracted_batch  String?
  extracted_mfg_date String?
  extracted_mrp    String?
  ocr_raw_json     Json?
  cv_anomaly_score Float?        // 0.0 (genuine) → 1.0 (suspicious)
  verdict          Verdict       @default(unverified)
  confidence       Float         @default(0)
  // Location — stored but anonymized in aggregate dashboard queries
  latitude         Float?
  longitude        Float?
  area_name        String?
  // @db.Timestamptz: REST inserts (src/app/api/verify/route.ts) never provide
  // this column, and the plain "timestamp" type Prisma defaults to here has no
  // UTC offset in its PostgREST JSON output — browsers then misparse it as
  // local time instead of UTC, showing scan times off by the viewer's UTC
  // offset. timestamptz fixes the wire format; see prisma/sql/manual_schema_patch.sql.
  created_at       DateTime      @default(now()) @db.Timestamptz(3)
  // GS1 / printed codes from medicine scans (null for food). `category` above
  // holds "Medicine" for these rows; the batch goes in extracted_batch.
  gtin             String?
  serial           String?
  expiry_date      DateTime?     @db.Date
  drap_reg_no      String?

  product  Product? @relation(fields: [product_id], references: [id])
  customer User?    @relation(fields: [customer_id], references: [id])
  reports  Report[]

  @@index([product_id])
  @@index([verdict])
  @@index([area_name])
  @@index([created_at])
  @@index([customer_id])
  @@index([gtin])
  @@index([serial])
  @@index([extracted_batch])
  @@index([drap_reg_no])
}

// ─────────────────────────────────────────────
// Medicine verification
// ─────────────────────────────────────────────

// Cache of DRAP's public registration / price data, filled by the pharma
// scraper so a scan never waits on (or breaks with) a DRAP outage.
// Row-level security: readable by anyone (public registry data), writable
// only with the service-role key — see the migration.
model DrapRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  reg_no       String   @unique
  brand_name   String
  generic_name String?
  strength     String?
  dosage_form  String?
  company      String?
  status       String?
  pack_size    String?
  mrp_pkr      Float?
  source       String   // "drap_price_index" | "drap_registry"
  source_url   String?
  fetched_at   DateTime @default(now()) @db.Timestamptz(3)
  raw          Json?

  @@index([brand_name])
}

// Every GS1 (01)+(21) pair seen in a scan. The same serial reported from
// several areas or by several people is a cloned code. reporter_keys holds
// customer ids and HMAC-hashed WhatsApp numbers — never raw phone numbers.
// Row-level security with no policies: only the record_medicine_serial()
// function (service-role) touches it — see the migration.
model MedicineSerial {
  id            String   @id @default(dbgenerated("gen_random_uuid()::text"))
  gtin          String
  serial        String
  batch         String?
  first_seen_at DateTime @default(now()) @db.Timestamptz(3)
  last_seen_at  DateTime @default(now()) @db.Timestamptz(3)
  scan_count    Int      @default(1)
  reporter_keys String[] @default([])
  areas         String[] @default([])

  @@unique([gtin, serial])
  @@index([serial])
  @@index([batch])
}

// ─────────────────────────────────────────────
// HORECA voucher model
//
// Consumers redeem scan points for dining vouchers at partner restaurants
// that cook with National Foods bulk condiments. The partner settles with NFL
// in bulk product credit rather than cash, so a voucher costs NFL wholesale
// COGS while reading as full retail value to the consumer.
//
// All three tables use dbgenerated ids for the same reason Scan/Report do:
// the routes under src/app/api/rewards, /vouchers and /partner insert over
// PostgREST, which never sees Prisma's client-side cuid().
// ─────────────────────────────────────────────

model Partner {
  id                     String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name                   String
  cuisine                String
  area                   String
  latitude               Float?
  longitude              Float?
  logo_url               String?
  nfl_account_ref        String?
  // Running total of bulk product credit NFL has issued this partner, in PKR.
  // Incremented by POST /api/partner/redeem on each successful redemption —
  // this is the B2B pull-through number the dashboard tile reports.
  bulk_credit_issued_pkr Float    @default(0)
  active                 Boolean  @default(true)
  created_at             DateTime @default(now()) @db.Timestamptz(3)

  offers RewardOffer[]

  @@index([area])
  @@index([active])
}

model RewardOffer {
  id                 String   @id @default(dbgenerated("gen_random_uuid()::text"))
  partner_id         String
  title_en           String
  title_ur           String
  description_en     String
  description_ur     String
  points_cost        Int
  consumer_value_pkr Float
  // What NFL credits the partner per redemption — held at ~40% of
  // consumer_value_pkr. That spread is the entire commercial argument.
  bulk_credit_pkr    Float
  active             Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(3)

  partner  Partner   @relation(fields: [partner_id], references: [id])
  vouchers Voucher[]

  @@index([partner_id])
  @@index([active])
}

model Voucher {
  id       String @id @default(dbgenerated("gen_random_uuid()::text"))
  user_id  String
  offer_id String
  // 8 chars, uppercase alphanumeric, ambiguous glyphs (O/0/I/1) excluded —
  // restaurant staff read these aloud and type them by hand.
  code     String @unique

  status      VoucherStatus @default(issued)
  issued_at   DateTime      @default(now()) @db.Timestamptz(3)
  expires_at  DateTime      @db.Timestamptz(3)
  // Nothing ever sets status = expired (the expiry cron is deliberately out of
  // scope — see TODO-horeca.md), so expiry is decided by comparing expires_at
  // to now at read time, never by trusting this enum.
  redeemed_at DateTime?     @db.Timestamptz(3)

  user  User        @relation(fields: [user_id], references: [id])
  offer RewardOffer @relation(fields: [offer_id], references: [id])

  @@index([user_id])
  @@index([offer_id])
  @@index([status])
}

model Report {
  // dbgenerated (not cuid()): src/app/api/report/route.ts and
  // src/app/api/incidents/[id]/flag/route.ts both insert via the REST API,
  // bypassing Prisma's client-side cuid() default — same reasoning as Scan.id
  // above.
  id         String       @id @default(dbgenerated("gen_random_uuid()::text"))
  scan_id    String
  brand_id   String
  status     ReportStatus @default(pending)
  notes      String?
  created_at DateTime     @default(now())

  scan  Scan  @relation(fields: [scan_id], references: [id])
  brand Brand @relation(fields: [brand_id], references: [id])

  @@index([scan_id])
  @@index([brand_id])
  @@index([status])
}
